# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT)
OPENAI_API_KEY=sk-...

# Finnhub (News & Sentiment) — free tier at https://finnhub.io
FINNHUB_API_KEY=

# Brave Search — optional, free tier (2000 req/mo) at https://brave.com/search/api/
BRAVE_API_KEY=

# Tavily (Web Search) — optional, free tier at https://tavily.com
TAVILY_API_KEY=

# Postgres — required. Everything the app records lives here.
# `docker compose up -d postgres` starts one matching this URL.
DATABASE_URL=postgres://stockcli:changeme@localhost:5432/stockcli
POSTGRES_PASSWORD=changeme
# POSTGRES_USER=stockcli
# POSTGRES_DB=stockcli

# Optional
FRED_API_KEY=

# Only EDGAR filings and generated reports are stored as files.
DATA_DIR=.data

# Perplexity AI
PPLX_API_KEY=

# Distill
DISTILL_API_URL=http://localhost:3000
DISTILL_API_KEY=
DISTILL_BRIEFING_TYPE_ID=fdb77f9c-bd9e-40ef-8b77-638fd4f1a4f7

# Logging: debug | info | warn | error
LOG_LEVEL=info

# ─── Hatchet (optional) ───────────────────────────────────────────────────────
# Task queue for the nightly pipeline. Everything still runs without it; the
# scheduler in src/scheduler.ts remains the default path until tasks move over.
#
# The token is minted in the Hatchet UI under Settings → API Tokens and already
# carries the server address, so it is usually the only variable you need.
# Verify with: pnpm hatchet:check
HATCHET_CLIENT_TOKEN=
# Only when the address inside the token is not reachable under that name:
# HATCHET_CLIENT_HOST_PORT=hatchet.example.com:7077
# Self-hosted without TLS termination in front of gRPC:
# HATCHET_CLIENT_TLS_STRATEGY=none
# What keeps environments apart on a shared tenant. The SDK prefixes workflow,
# cron and worker names with it, so a worker started here cannot pick up a
# production task. Set it on developer machines; leave it empty in production.
# HATCHET_CLIENT_NAMESPACE=dev
#
# Rate limits are deliberately NOT namespaced by Hatchet, and that is the
# behaviour to keep: there is one Finnhub quota, so dev and production draw
# from a single budget instead of each assuming it has the whole thing.
#
# Only production should own the nightly cron. Without this a developer machine
# installs a competing one, queueing work against a laptop that is asleep most
# of the night — and firing all of it at once when it wakes.
# HATCHET_SCHEDULE_ENABLED=false
#
# Which tasks a worker process serves: all | general | distill | analysis.
# Unset means `all` — one process for everything, which is what `pnpm dev`
# starts and the right shape until you have a reason to split.
#
# Production splits it, because a worker's slot count is the only limit Hatchet
# enforces across processes: the distill worker has one slot, so "one at a time"
# holds no matter how many replicas run. Splitting also stops a queued task
# holding a slot it is not using.
# HATCHET_WORKER_ROLE=general
#
# Overrides the slots for the role. Leave it unset: for `distill` and
# `analysis` the slot count *is* the limit, and overriding it raises the limit
# without saying so anywhere else.
# HATCHET_WORKER_SLOTS=64
